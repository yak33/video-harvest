{
  "manifest_version": 3,
  "name": "VideoHarvest",
  "version": "0.2.0",
  "description": "Download videos from almost any website. Direct media, HLS (m3u8) and DASH (mpd) supported.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VideoHarvest"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "engine/engine.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}